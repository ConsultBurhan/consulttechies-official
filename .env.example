# Copy to .env.local and fill in. Never commit real values.
# Contact form email goes through Microsoft Graph (client-credentials flow).

# Where enquiries are delivered
MAIL_TO=info@consulttechies.com
# Mailbox the messages are sent from (must exist in your Microsoft 365 tenant)
MAIL_FROM=no-reply@consulttechies.com
# Optional display name for the sender
MAIL_FROM_NAME=Babji Consult Techies
# Optional: copy every enquiry to a second address
CC_EMAIL=
# Set to "false" to stop sending the visitor a confirmation email
MAIL_ACKNOWLEDGE=true

# Azure AD app registration (Entra ID > App registrations)
# API permission needed: Microsoft Graph > Application > Mail.Send, with admin consent.
# Tip: restrict the app to MAIL_FROM with an Exchange Application Access Policy.
AZURE_TENANT=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Optional overrides (defaults shown)
# AZURE_TOKEN_URI=https://login.microsoftonline.com/{0}/oauth2/v2.0/token
# GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
# GRAPH_SCOPE=https://graph.microsoft.com/.default
# EMAIL_TIMEOUT_SECONDS=30
